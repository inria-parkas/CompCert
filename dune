(rule
 (targets compcert.ini)
 (action
  (with-stdout-to
   compcert.ini
   (run ini_creator))))

(rule
 (targets compcert.config)
 (action
  (with-stdout-to
   compcert.config
   (run config_creator))))

(env
 (_
  (binaries
   tools/ndfun.exe
   tools/modorder.exe
   tools/config_to_ml.exe
   tools/ini_creator.exe
   tools/config_creator.exe
   tools/gen_documentation.exe)))
